--- a/drivers/clk/ralink/clk-mt7621.c
+++ b/drivers/clk/ralink/clk-mt7621.c
@@ -36,6 +36,35 @@
 	struct regmap *sysc;
 	struct regmap *memc;
 };
+
+/* Early MT7621 CPU PLL override for Redmi AC2100 (~1000MHz). */
+static void __init mt7621_early_pll_oc(struct mt7621_clk_priv *priv)
+{
+	static const u32 prediv_tbl[] = { 0, 1, 2, 2 };
+	u32 sysc_val, pll_val, prediv, fbdiv;
+	unsigned long xtal, est;
+
+	regmap_read(priv->sysc, SYSC_REG_SYSTEM_CONFIG0, &sysc_val);
+	sysc_val = FIELD_GET(XTAL_MODE_SEL_MASK, sysc_val);
+	xtal = sysc_val <= 2 ? 20000000 : sysc_val <= 5 ? 40000000 : 25000000;
+
+	regmap_read(priv->memc, MEMC_REG_CPU_PLL, &pll_val);
+	prediv = FIELD_GET(CPU_PLL_PREDIV_MASK, pll_val);
+	fbdiv = FIELD_GET(CPU_PLL_FBDIV_MASK, pll_val);
+	est = ((fbdiv + 1) * xtal) >> prediv_tbl[prediv];
+	pr_info("mt7621-oc: PLL before=0x%08x cpu=%luMHz", pll_val, est / 1000000);
+
+	/* 1000MHz = (FBDIV + 1) * xtal >> prediv_tbl[prediv]. */
+	fbdiv = (1000000000UL << prediv_tbl[prediv]) / xtal - 1;
+	pll_val &= ~CPU_PLL_FBDIV_MASK;
+	pll_val |= FIELD_PREP(CPU_PLL_FBDIV_MASK, fbdiv);
+	regmap_write(priv->memc, MEMC_REG_CPU_PLL, pll_val);
+
+	regmap_read(priv->memc, MEMC_REG_CPU_PLL, &pll_val);
+	fbdiv = FIELD_GET(CPU_PLL_FBDIV_MASK, pll_val);
+	est = ((fbdiv + 1) * xtal) >> prediv_tbl[prediv];
+	pr_info("mt7621-oc: PLL after=0x%08x cpu=%luMHz", pll_val, est / 1000000);
+}
 
 struct mt7621_clk {
 	struct clk_hw hw;
@@ -370,6 +399,8 @@
 		goto free_clk_priv;
 	}
 
+	mt7621_early_pll_oc(priv);
+
 	count = ARRAY_SIZE(mt7621_clks_base) +
 		ARRAY_SIZE(mt7621_fixed_clks) + ARRAY_SIZE(mt7621_gates);
 	clk_data = kzalloc_flex(*clk_data, hws, count);
